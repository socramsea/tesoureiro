DATABASE_URL=postgresql://tesoureiro:tesoureiro@postgres:5432/tesoureiro
ANTHROPIC_API_KEY=coloque_sua_chave
ANTHROPIC_MODEL=claude-sonnet-4-5
TESOUREIRO_API_KEY=
TESOUREIRO_DEMO=1
TESOUREIRO_MAX_CALLS_DAY=300
TESOUREIRO_RATE_PER_MIN=10

# Cadeia de failover — ordem de preferência; provedor sem chave é ignorado
TESOUREIRO_PROVIDERS=anthropic,deepseek,ollama
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Compliance em tempo real (CEIS/CNEP) — chave gratuita:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
